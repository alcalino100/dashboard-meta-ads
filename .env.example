# ────────────────────────────────────────────────────────────
# Dashboard Meta Ads — variáveis de ambiente
# Copie para .env.local e preencha os valores reais.
# NUNCA comite o .env.local no repositório.
# ────────────────────────────────────────────────────────────

# Meta / Facebook Ads
# Token do System User com escopos: ads_read, ads_management
META_ACCESS_TOKEN=

# App ID do seu app em developers.facebook.com
META_APP_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente server-side (admin client)
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth / Auth.js (se utilizado)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
