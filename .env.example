# ────────────────────────────────────────────────────────────
# Dashboard Meta Ads — variáveis de ambiente
# Copie para .env.local e preencha os valores reais.
# NUNCA comite o .env.local no repositório.
# ────────────────────────────────────────────────────────────

# Meta / Facebook Ads
# System User Token permanente (nunca expira) — escopos: ads_read, ads_management, business_management
META_ACCESS_TOKEN=

# ID do app no Meta for Developers
META_APP_ID=

# Secret do app (necessário para debug_token / detecção do tipo de token)
META_APP_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente server-side (admin client)
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth / Auth.js (se utilizado)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
